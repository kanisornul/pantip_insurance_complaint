	column 'duration_min_post_to_first_company_res (bins)' =
			IF(
				ISBLANK('post_details'[duration_min_post_to_first_company_res]),
				BLANK(),
				IF(
					'post_details'[duration_min_post_to_first_company_res] >= 0,
					ROUNDDOWN('post_details'[duration_min_post_to_first_company_res] / 600, 0) * 600,
					ROUNDUP('post_details'[duration_min_post_to_first_company_res] / 600, 0) * 600
				)
			)
		lineageTag: 7bdf75fb-5082-47e5-af83-7dc2e149244f
		summarizeBy: none

