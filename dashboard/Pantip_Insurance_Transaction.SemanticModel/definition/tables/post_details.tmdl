table post_details
	lineageTag: acf1a919-0486-49ff-b59a-b18d02a5c3e6

	measure CountID = DISTINCTCOUNT(post_details[id])
		formatString: #,0
		lineageTag: 5484c8d1-1df2-40ad-94e0-ee09eb7d8cef

	measure 'Med Company Response' = ```
			
			VAR TotalMinutes = 
			    MEDIAN(post_details[duration_min_post_to_first_company_res])
			
			-- Convert minutes into a fraction of a 24-hour day
			RETURN TotalMinutes
			```
		lineageTag: 077e79bd-aa30-4fae-b2e9-f0b139bbea9f

		formatStringDefinition = ```
				VAR TotalMinutes = SELECTEDMEASURE()
				VAR Days = INT(TotalMinutes / 1440)
				VAR RemainingAfterDays = MOD(TotalMinutes, 1440)
				VAR Hours = INT(RemainingAfterDays / 60)
				VAR Minutes = ROUND(MOD(RemainingAfterDays, 60), 0)
				
				RETURN 
				    IF(
				        ISBLANK(TotalMinutes), 
				        """--""", 
				        """" & FORMAT(Days, "00") & "d " & FORMAT(Hours, "00") & ":" & FORMAT(Minutes, "00") & """"
				    )
				```

	measure 'Outlier Response Duration' = ```
			
			VAR CurrentYear = SELECTEDVALUE(post_details[PostCreateYear])
			VAR Q1 = 
			    CALCULATE(
			        PERCENTILEX.INC(ALLSELECTED(post_details)   
			        , [duration_min_post_to_first_company_res], 0.25),
			        VALUES(post_details[PostCreateYear])
			    )
			VAR Q3 = 
			    CALCULATE(
			        PERCENTILEX.INC(ALLSELECTED(post_details)  , [duration_min_post_to_first_company_res], 0.75),
			        VALUES(post_details[PostCreateYear])
			    )
			VAR IQR = Q3 - Q1
			VAR UpperFence = Q3 + (1.5 * IQR)
			--VAR CurrentValue = [duration_min_post_to_first_company_res]
			
			RETURN
			    -- Return 1 if it is a normal value, 0 if it is a High Outlier
			    IF(MAX([duration_min_post_to_first_company_res]) > UpperFence, 1, 0)
			```
		formatString: 0
		lineageTag: 1dcfa2d0-2933-40d2-a08a-d35a26e564ef

	measure 'Mean Company Response' = AVERAGE(post_details[duration_min_post_to_first_company_res])
		lineageTag: 0be68325-60ea-4bdb-91d5-af0dc096211b

		formatStringDefinition = ```
				VAR TotalMinutes = SELECTEDMEASURE()
				VAR Days = INT(TotalMinutes / 1440)
				VAR RemainingAfterDays = MOD(TotalMinutes, 1440)
				VAR Hours = INT(RemainingAfterDays / 60)
				VAR Minutes = ROUND(MOD(RemainingAfterDays, 60), 0)
				
				RETURN 
				    IF(
				        ISBLANK(TotalMinutes), 
				        """--""", 
				        """" & FORMAT(Days, "00") & "d " & FORMAT(Hours, "00") & ":" & FORMAT(Minutes, "00") & """"
				    )
				```

	measure 'Duration Company Response (No OL)' = ```
			
			VAR Q1 = 
			    CALCULATE(
			        PERCENTILEX.INC(ALLSELECTED(post_details)   
			        , [duration_min_post_to_first_company_res], 0.25)
			    )
			VAR Q3 = 
			    CALCULATE(
			        PERCENTILEX.INC(ALLSELECTED(post_details)  , [duration_min_post_to_first_company_res], 0.75)
			    )
			VAR IQR = Q3 - Q1
			VAR UpperFence = Q3 + (1.5 * IQR)
			VAR CurrentValue = SELECTEDVALUE(post_details[duration_min_post_to_first_company_res])
			
			RETURN
			IF(
			    CurrentValue <= UpperFence, 
			    CurrentValue, 
			    BLANK()
			)
			```
		lineageTag: bca2f273-5bc4-483d-a638-6ea4fd2aa856

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure %ResponsePost =
			DIVIDE(
			    CALCULATE(COUNTROWS(post_details), post_details[first_comp_company_name] <> ""),
			    COUNTROWS(post_details)
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 47407b03-054d-496f-955e-9b039c9558e8

	measure 'Med Company Response (Exc. OL)' =
			
			VAR Med = [Med Company Response]
			VAR MAD = MEDIANX(post_details,
			          ABS(post_details[duration_min_post_to_first_company_res] - Med)
			          )
			VAR K = 3
			VAR UpperBound = Med + K * Med
			
			RETURN
			AVERAGEX(
			    FILTER(
			        post_details,
			        post_details[duration_min_post_to_first_company_res] <= UpperBound)
			        ,
			        post_details[duration_min_post_to_first_company_res]
			)
		lineageTag: eaa563ca-e10c-4a91-9139-1a206362ccea

		formatStringDefinition = ```
				VAR TotalMinutes = SELECTEDMEASURE()
				VAR Days = INT(TotalMinutes / 1440)
				VAR RemainingAfterDays = MOD(TotalMinutes, 1440)
				VAR Hours = INT(RemainingAfterDays / 60)
				VAR Minutes = ROUND(MOD(RemainingAfterDays, 60), 0)
				
				RETURN 
				    IF(
				        ISBLANK(TotalMinutes), 
				        """--""", 
				        """" & FORMAT(Days, "00") & "d " & FORMAT(Hours, "00") & ":" & FORMAT(Minutes, "00") & """"
				    )
				```

	measure 'Mean Company Response (Trim Tail 2%)' = ```
			
			VAR P98 = 
			CALCULATE(
			    PERCENTILEX.INC(
			        post_details,
			        post_details[duration_min_post_to_first_company_res],
			        0.98),
			        ALLEXCEPT(post_details, post_details[PostCreateYear])
			)
			
			RETURN
			AVERAGEX(
			    FILTER(
			        post_details,
			        post_details[duration_min_post_to_first_company_res] <= P98)
			        ,
			        post_details[duration_min_post_to_first_company_res]
			)
			```
		lineageTag: 92bbc678-e2da-4b1a-a15b-e17f9aa6ed6f

		formatStringDefinition = ```
				VAR TotalMinutes = SELECTEDMEASURE()
				VAR Days = INT(TotalMinutes / 1440)
				VAR RemainingAfterDays = MOD(TotalMinutes, 1440)
				VAR Hours = INT(RemainingAfterDays / 60)
				VAR Minutes = ROUND(MOD(RemainingAfterDays, 60), 0)
				
				RETURN 
				    IF(
				        ISBLANK(TotalMinutes), 
				        """--""", 
				        """" & FORMAT(Days, "00") & "d " & FORMAT(Hours, "00") & ":" & FORMAT(Minutes, "00") & """"
				    )
				```

	measure 'Trimmed Count' = ```
			
			VAR P98 = 
			CALCULATE(
			    PERCENTILEX.INC(
			        post_details,
			        post_details[duration_min_post_to_first_company_res],
			        0.98
			    ),
			    ALLEXCEPT(post_details, post_details[PostCreateYear])
			)
			
			VAR TotalN = CALCULATE(
			    COUNTROWS(post_details),
			    ALLEXCEPT(post_details, post_details[PostCreateYear]))
			
			VAR KeptN = CALCULATE(
			    COUNTROWS(post_details),
			        FILTER(post_details, post_details[duration_min_post_to_first_company_res] <= P98),
			        ALLEXCEPT(post_details, post_details[PostCreateYear]))
			
			RETURN 1-DIVIDE(KeptN, TotalN)
			```
		lineageTag: 63203939-7267-4d2d-9554-9e956534b1b8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

